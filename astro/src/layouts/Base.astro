---
import { Font } from "astro:assets";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Rendered into <title> as-is when set; otherwise "<title> · Frank Huettner". */
  rawTitle?: boolean;
}

const {
  title,
  description = "Frank Huettner — Assistant Professor of Decision Sciences at SKK GSB. Cooperative game theory, the Shapley value, rational inattention, and operations.",
  rawTitle = false,
} = Astro.props;

const pageTitle = title ? (rawTitle ? title : `${title} · Frank Huettner`) : "Frank Huettner";
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav = [
  { href: "/", label: "about" },
  { href: "/publications/", label: "research" },
  { href: "/projects/", label: "code" },
];

const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, "")));
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Frank Huettner — news" href="/rss.xml" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐼</text></svg>"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <a class="masthead__name" href="/">Frank Huettner</a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
            </svg>
          </button>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-foot">
        <span>© {new Date().getFullYear()} Frank Huettner</span>
        <span>
          <a href="https://github.com/frankhuettner">GitHub</a> ·
          <a href="https://orcid.org/0000-0002-5489-1334">ORCID</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </footer>
    </div>

    <script is:inline>
      // Abstract disclosure on publication entries.
      document.addEventListener("click", (event) => {
        const btn = event.target.closest("[data-abstract-toggle]");
        if (!btn) return;
        const panel = btn.closest(".paper__body")?.querySelector(".paper__abstract");
        if (!panel) return;
        const open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        panel.hidden = open;
      });

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
