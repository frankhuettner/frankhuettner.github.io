---
// Workshop II (ABP, SKK GSB): the homework and, for each morning, everything the slides ask the students to type.
// The Markdown comes from the course repo (n8n-workshop: python system/canvas.py --site <this repo>), never edited
// here. Every code block gets a Copy button (Frank, 2 Nov 2026: "mit kopier knopf"); the one script on these pages.
import Base from "../../../layouts/Base.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  const files = import.meta.glob<any>("../../../data/abp/ws2-*.md", { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { part: path.match(/ws2-(\w+)\.md$/)![1] },
    props: { title: mod.frontmatter.title as string, Content: mod.Content },
  }));
};

const { title, Content } = Astro.props;
---

<Base title={title} description="Agentic AI in Business, Workshop II: instructions and snippets to copy.">
  <header class="page-head">
    <p class="label">Agentic AI in Business · Workshop II</p>
    <h1>{title}</h1>
  </header>

  <article class="prose body ws2">
    <Content />
  </article>
</Base>

<script is:inline>
  document.querySelectorAll(".ws2 pre").forEach((pre) => {
    const box = document.createElement("div");
    box.className = "snip";
    pre.replaceWith(box);
    box.append(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      const text = pre.innerText.replace(/\n$/, "");
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        getSelection().removeAllRanges();
        getSelection().addRange(range);
        document.execCommand("copy");
      }
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = "Copy"), 1500);
    });
    box.append(btn);
  });
</script>

<style is:global>
  .ws2.body {
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--rule);
  }

  .ws2 .snip {
    position: relative;
  }

  .ws2 .snip pre {
    white-space: pre-wrap;
    word-break: break-word;
    padding: 0.7rem 5.5rem 0.7rem 0.9rem !important;   /* room for the button; the site's pre style sets its own */
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-sm);
  }

  .ws2 .copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }

  .ws2 .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ws2 table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92em;
  }

  .ws2 th,
  .ws2 td {
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }
</style>
