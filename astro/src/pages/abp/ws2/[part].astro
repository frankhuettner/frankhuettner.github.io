---
// Workshop II (ABP, SKK GSB): the homework and, for each morning, everything the slides ask the students to type.
// The Markdown comes from the course repo (n8n-workshop: python system/canvas.py --site <this repo>), never edited
// here. Every code block gets a Copy button (Frank, 2 Nov 2026: "mit kopier knopf"). The layout follows the kingo-pod
// guides (Frank, 2 Nov: "mach noch ein toc wie im kingo pod"): the pages on the left, this page's headings on the right.
import Base from "../../../layouts/Base.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  const files = import.meta.glob<any>("../../../data/abp/ws2-*.md", { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { part: path.match(/ws2-(\w+)\.md$/)![1] },
    props: { title: mod.frontmatter.title as string, Content: mod.Content, headings: mod.getHeadings() },
  }));
};

// The pages in the order of the course, as the column on the left names them.
const LABELS: Record<string, string> = { hw: "Homework", s1: "9 November", s2: "16 November", s3: "23 November" };
const parts = Object.keys(import.meta.glob("../../../data/abp/ws2-*.md")).map((p) => p.match(/ws2-(\w+)\.md$/)![1]);

const { part } = Astro.params;
const { title, Content, headings } = Astro.props;
// h2 is a part or a block; h3 is a step inside it. Deeper levels would only add noise.
const toc = (headings as { depth: number; slug: string; text: string }[]).filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description="Agentic AI in Business, Workshop II: instructions and snippets to copy.">
  <div class="ws2-guide">
    <nav class="ws2-pages" aria-label="Workshop II">
      <p class="label">Workshop II</p>
      <ul>
        {
          parts.map((p) => (
            <li>
              <a href={`/abp/ws2/${p}/`} aria-current={p === part ? "page" : undefined}>
                {LABELS[p] ?? p}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ws2-main">
      <header class="page-head">
        <p class="label">Agentic AI in Business · Workshop II</p>
        <h1>{title}</h1>
      </header>

      <details class="ws2-toc ws2-toc--mobile">
        <summary>On this page</summary>
        <ul>
          {
            toc.map((h) => (
              <li class={`ws2-toc__item--${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))
          }
        </ul>
      </details>

      <article class="prose body ws2">
        <Content />
      </article>
    </div>

    <nav class="ws2-toc ws2-toc--rail" aria-label="On this page">
      <p class="label">On this page</p>
      <ul>
        {
          toc.map((h) => (
            <li class={`ws2-toc__item--${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll(".ws2 pre").forEach((pre) => {
    const box = document.createElement("div");
    box.className = "snip";
    pre.replaceWith(box);
    box.append(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      const text = pre.innerText.replace(/\n$/, "");
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        getSelection().removeAllRanges();
        getSelection().addRange(range);
        document.execCommand("copy");
      }
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = "Copy"), 1500);
    });
    box.append(btn);
  });

  // Mark the section being read in the contents on the right.
  const links = new Map();
  document.querySelectorAll(".ws2-toc--rail a").forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
  if (targets.length && "IntersectionObserver" in window) {
    const seen = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
        const current = targets.find((t) => seen.has(t.id));
        links.forEach((a, id) => a.classList.toggle("is-current", !!current && id === current.id));
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style is:global>
  /* Three columns where there is room for them, as on the kingo-pod guides: the pages of Workshop II on the left,
     the text in the middle, this page's headings on the right. Only these pages get the wider shell. Each side
     column drops away where keeping it would squeeze the text: the pages at 78rem (they become a row above the
     title), the contents at 68rem (they fold into "On this page" above the text). */
  .shell:has(.ws2-guide) {
    max-width: 76rem;
  }

  .ws2-guide {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) 13rem;
    gap: 0 2.25rem;
    align-items: start;
  }

  .ws2-pages,
  .ws2-toc--rail {
    position: sticky;
    top: 1.5rem;
    margin-top: 2.5rem;
    font-size: var(--step--1);
  }

  .ws2-pages {
    border-right: 1px solid var(--rule-soft);
    padding-right: 1rem;
  }

  .ws2-toc--rail {
    border-left: 1px solid var(--rule-soft);
    padding-left: 1rem;
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
  }

  .ws2-pages ul,
  .ws2-toc ul {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .ws2-pages ul {
    padding-left: 0.7rem;
  }

  .ws2-pages a,
  .ws2-toc a {
    display: block;
    padding-block: 0.22rem;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .ws2-pages a:hover,
  .ws2-toc a:hover {
    color: var(--accent);
  }

  .ws2-pages a[aria-current="page"],
  .ws2-toc a.is-current {
    color: var(--ink);
    font-weight: 600;
  }

  .ws2-toc__item--3 {
    padding-left: 0.8rem;
  }

  .ws2-toc--mobile {
    display: none;
    margin-bottom: 1.6rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--bg-soft);
    padding: 0.7rem 1rem;
    font-size: var(--step--1);
  }

  .ws2-toc--mobile summary {
    cursor: pointer;
    color: var(--ink-muted);
    font-weight: 500;
  }

  @media (max-width: 78rem) {
    .ws2-guide {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }

    .ws2-pages {
      grid-column: 1 / -1;
      position: static;
      margin-top: 1.4rem;
      border-right: 0;
      padding-right: 0;
      border-bottom: 1px solid var(--rule);
      padding-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 1.2rem;
    }

    .ws2-pages ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.2rem 1.2rem;
      margin: 0;
      padding-left: 0;
    }

    .ws2-pages a {
      padding-block: 0;
    }
  }

  @media (max-width: 68rem) {
    .ws2-guide {
      grid-template-columns: minmax(0, 1fr);
    }

    .ws2-toc--rail {
      display: none;
    }

    .ws2-toc--mobile {
      display: block;
    }
  }

  .ws2.body {
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--rule);
    overflow-wrap: break-word;   /* a long link (the app passwords page) would push a phone's page sideways */
  }

  .ws2 .snip {
    position: relative;
  }

  .ws2 .snip pre {
    white-space: pre-wrap;
    word-break: break-word;
    padding: 0.7rem 5.5rem 0.7rem 0.9rem !important;   /* room for the button; the site's pre style sets its own */
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-sm);
  }

  .ws2 .copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }

  .ws2 .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ws2 table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92em;
  }

  .ws2 th,
  .ws2 td {
    text-align: left;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
    overflow-wrap: anywhere;   /* long file names must not push a phone's page sideways */
  }
</style>
