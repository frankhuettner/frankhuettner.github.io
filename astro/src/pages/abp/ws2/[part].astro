  }

  .ws2 .hx-banner__lines .logo { color: #d97757; }
  .ws2 .hx-banner__lines b { color: #fff; }

  .ws2 .hx-banner__lines mark {
    padding: 0 0.2rem;
    border-radius: 0.2rem;
    background: rgb(255 154 82 / 0.16);
    box-shadow: inset 0 -2px 0 var(--t-hot);
    color: #fff;
  }

  /* Step 6: how often Claude Code got lost in our three tests (Frank, 18 Nov 2026: the bars of the run times were
     "not convincing"). One card per test, one mark per time; the cards stack on a narrow screen. */
  .ws2 .hx-det .hx-det__head { margin: 0 0 0.8rem; text-align: left; font-size: 0.95rem; font-weight: 600; color: var(--ink); }

  .ws2 .hx-det__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ws2 .hx-det__cards > li {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .ws2 .hx-det__cards > li.hot { border-color: var(--bp-brain); box-shadow: inset 0 3px 0 var(--bp-brain); }
  .ws2 .hx-det .t { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .ws2 .hx-det .t b { font-size: 0.95rem; color: var(--ink); }
  .ws2 .hx-det .t span { font-size: var(--step--1); font-variant-numeric: tabular-nums; color: var(--ink-muted); white-space: nowrap; }
  .ws2 .hx-det .who { margin-top: -0.35rem; font-size: var(--step--1); line-height: 1.35; color: var(--ink-muted); }
  .ws2 .hx-det__cards ul { display: grid; gap: 0.5rem; margin: 0.15rem 0 0; padding: 0; list-style: none; }
  .ws2 .hx-det__cards ul li { display: grid; gap: 0.2rem; margin: 0; font-size: var(--step--1); line-height: 1.4; color: var(--ink); }
  .ws2 .hx-det .marks { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .ws2 .hx-det .marks:empty { display: none; }
  .ws2 .hx-det .mk { display: inline-grid; width: 1.15rem; height: 1.15rem; color: var(--ink); }
  .ws2 .hx-det .hot .mk { color: var(--bp-brain); }
  .ws2 .hx-det .mk svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ws2 .hx-det .end { display: flex; align-items: center; gap: 0.35rem; margin: auto 0 0; padding-top: 0.45rem; border-top: 1px solid var(--rule-soft); font-size: var(--step--1); font-weight: 600; }
  .ws2 .hx-det .end .hx-ico { width: 1.1rem; height: 1.1rem; border: 0; background: none; color: inherit; }
  .ws2 .hx-det .end .hx-ico svg { width: 100%; height: 100%; stroke-width: 2; }
  .ws2 .hx-det .end.ok { color: var(--hx-ok); }
  .ws2 .hx-det .end.no { color: var(--hx-no); }
  .ws2 .hx-det .hx-det__foot { margin: 0.7rem 0 0; font-size: var(--step--1); color: var(--ink-muted); }

  @media (max-width: 760px) {
    .ws2 .hx-det__cards { grid-template-columns: minmax(0, 1fr); }
  }

  /* Step 7: what the model reads again at every step. */
  .ws2 .hx-ctx {
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .ws2 .hx-ctx__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.3rem 1rem; font-size: var(--step--1); }
  .ws2 .hx-ctx__head b { color: var(--ink); }
  .ws2 .hx-ctx__head span { color: var(--ink-muted); }

  .ws2 .hx-ctx__blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    min-height: 2.6rem;
    margin: 0.6rem 0;
    padding: 3px;
    border: 1.5px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--bg);
    list-style: none;
  }

  .ws2 .hx-ctx__blocks li {
    margin: 0;
    padding: 0.28rem 0.55rem;
    border: 1px solid var(--c);
    border-radius: 4px;
    background: var(--c-soft);
    font-size: var(--step--1);
    line-height: 1.3;
    color: var(--ink);
  }

  .ws2 .hx-ctx__blocks .start { --c: var(--hx-tool); --c-soft: var(--hx-tool-soft); }
  .ws2 .hx-ctx__blocks .you { --c: var(--bp-person); --c-soft: var(--bp-person-soft); }
  .ws2 .hx-ctx__blocks .bad { --c: var(--hx-no); --c-soft: var(--hx-no-soft); }
  .ws2 .hx-ctx__blocks .fresh { --c: var(--hx-ok); --c-soft: var(--hx-ok-soft); }
  .ws2 .hx-ctx__keys { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .ws2 .hx-ctx__keys button,
  .ws2 .hx-term__keys button,
  .ws2 .quiz.sort .sq-bar button {
    transition: transform 0.15s, border-color 0.15s;
  }

  .ws2 .hx-ctx__keys button,
  .ws2 .quiz.sort .sq-bar button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.35rem 0.8rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .ws2 .hx-ctx__keys button:hover,
  .ws2 .quiz.sort .sq-bar button:hover { border-color: var(--bp-person); transform: translateY(-1px); }
  .ws2 .hx-ctx__keys button code { color: inherit; }
  .ws2 .hx-ctx__say { margin: 0.55rem 0 0; font-size: var(--step--1); }

  /* Step 8: /rewind on the files of your folder, and on Langflow and n8n. */
  .ws2 .hx-rewind {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .ws2 .hx-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 0.9rem 0.8rem;
    border: 1.5px solid var(--c);
    border-radius: var(--radius);
    background: var(--c-soft);
    text-align: center;
  }

  .ws2 .hx-zone.ok { --c: var(--hx-ok); --c-soft: var(--hx-ok-soft); }
  .ws2 .hx-zone.no { --c: var(--bp-muscle); --c-soft: var(--bp-muscle-soft); }
  .ws2 .hx-zone > b { color: var(--ink); }
  .ws2 .hx-zone > span:not(.hx-ico) { font-size: var(--step--1); color: var(--ink-muted); }
  .ws2 .hx-zone strong { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--step--1); color: var(--ink); }
  .ws2 .hx-zone strong .hx-ico { width: 1.6rem; height: 1.6rem; border-width: 1.5px; }
  .ws2 .hx-zone strong .hx-ico svg { width: 0.9rem; height: 0.9rem; }
  .ws2 .hx-zone.no strong em { font-style: normal; color: var(--hx-no); }

  .ws2 .hx-tl {
    position: relative;
    display: flex;
    justify-content: space-between;
    width: 78%;
    margin: 0.9rem auto 0.5rem;
    padding-top: 0.35rem;
    border-top: 2px solid var(--rule);
  }

  .ws2 .hx-tl i { position: relative; font-style: normal; font-size: 0.72rem; color: var(--ink-muted); }

  .ws2 .hx-tl i::before {
    content: "";
    position: absolute;
    top: -0.68rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin-left: -0.275rem;
    border-radius: 50%;
    background: var(--c);
  }

  .ws2 .hx-tl u {
    position: absolute;
    top: -0.95rem;
    right: -0.15rem;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: var(--ink);
  }

  .ws2 .hx-tl em {
    position: absolute;
    top: -1.2rem;
    right: 22%;
    width: 3px;
    height: 1.4rem;
    border-radius: 2px;
    background: var(--hx-no);
  }

  @container (max-width: 30rem) {
    .ws2 .hx-rewind { grid-template-columns: minmax(0, 1fr); }
  }

  /* A real case from our tests: the model it came from, in the corner. */
  .ws2 .case {
    margin: 1.2rem 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--rule-soft);
    border-left: 4px solid var(--bp-brain);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }

  .ws2 .case::before {
    content: attr(data-model);
    float: right;
    margin: -0.15rem -0.3rem 0.4rem 0.8rem;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--bp-brain);
    border-radius: 999px;
    background: var(--bp-brain-soft);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* The case of step 4: who said what, one step a line, with room between (Frank, 18 Nov 2026: "use more space"). */
  .ws2 .case ol { margin: 1rem 0 0; padding-left: 1.4rem; }
  .ws2 .case ol > li { margin: 0 0 1.4rem; }
  .ws2 .case ol > li > p { margin: 0 0 0.6rem; }
  .ws2 .case blockquote { margin: 0.6rem 0 0.6rem; }
  .ws2 .case > :first-child { margin-top: 0; }
  .ws2 .case > :last-child { margin-bottom: 0; }

  /* A sort quiz: <div class="quiz sort"> around a table; its second column names the boxes. */
  .ws2 .quiz.sort .sq-pool {
    min-height: 2.6rem;
    margin: 0.6rem 0;
    padding: 0.4rem;
    border: 1px dashed currentColor;
    border-radius: var(--radius);
  }

  .ws2 .quiz.sort .sq-bins {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .ws2 .quiz.sort .sq-bin {
    min-height: 6.5rem;
    padding: 0.5rem;
    border: 2px dashed var(--c);
    border-radius: var(--radius);
    background: var(--bg);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .ws2 .quiz.sort .sq-bin:nth-child(1) { --c: var(--hx-tool); --c-soft: var(--hx-tool-soft); }
  .ws2 .quiz.sort .sq-bin:nth-child(2) { --c: var(--bp-brain); --c-soft: var(--bp-brain-soft); }
  .ws2 .quiz.sort .sq-bin.over { background: var(--c-soft); }

  .ws2 .quiz.sort .sq-bin > b {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
    font-size: var(--step--1);
  }

  .ws2 .quiz.sort .sq-bin > b::before {
    content: "";
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--c);
    border-radius: 50%;
    background: var(--c-soft);
  }

  .ws2 .quiz.sort .sq-chip {
    display: inline-block;
    margin: 0.2rem;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid var(--rule-soft);
    border-radius: 0.45rem;
    background: var(--bg-soft);
    color: var(--ink);
    font-size: 0.92em;
    line-height: 1.35;
    cursor: grab;
    user-select: none;
    transition: transform 0.15s, border-color 0.15s;
  }

  .ws2 .quiz.sort .sq-chip:hover { transform: translateY(-1px); border-color: var(--bp-person); }
  .ws2 .quiz.sort .sq-chip.picked { outline: 2px solid var(--bp-person); }
  .ws2 .quiz.sort .sq-chip.right { border-color: var(--hx-ok); }
  .ws2 .quiz.sort .sq-chip.right::after { content: " ✓"; font-weight: 700; color: var(--hx-ok); }
  .ws2 .quiz.sort .sq-chip.wrong { border-color: var(--hx-no); }
  .ws2 .quiz.sort .sq-chip.wrong::after { content: " ✗"; font-weight: 700; color: var(--hx-no); }
  .ws2 .quiz.sort .sq-bar { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin: 0.6rem 0 0; }

  @container (max-width: 26rem) {
    .ws2 .quiz.sort .sq-bins { grid-template-columns: minmax(0, 1fr); }
  }

  .ws2 .quiz.sort { container-type: inline-size; }

  /* The habits on one page as cards; the table stays for the page without the script. */
  .ws2 .habit-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.7rem;
    margin: 1rem 0 1.4rem;
    padding: 0;
    list-style: none;
    counter-reset: habit;
  }

  .ws2 .habit-cards li {
    position: relative;
    margin: 0;
    padding: 0.85rem 0.9rem 0.8rem 3rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--bg-soft);
    counter-increment: habit;
  }

  .ws2 .habit-cards li::before {
    content: counter(habit);
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--bp-person);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ws2 .habit-cards b { display: block; line-height: 1.3; color: var(--ink); }
  .ws2 .habit-cards .gain { display: block; margin-top: 0.3rem; font-size: var(--step--1); line-height: 1.4; }
  .ws2 .habit-cards .habit-src { display: block; margin-top: 0.45rem; font-size: 0.74rem; color: var(--ink-muted); }

  /* ---- More to click, more motion (Frank, 18 Nov 2026: "animationen einfügen wenn möglich. mehr click-erlebnisse.
     die quizze noch interactiver und mit animation"). ---- */
  .ws2 .hx-i {
    width: 1em;
    height: 1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: -0.14em;
  }

  /* The practice terminal, before step 1. */
  .ws2 .hx-try .hx-term { max-width: 46rem; margin: 0 auto; }
  .ws2 .hx-try__log {
    min-height: 8.5rem;
    max-height: 15rem;
    margin: 0;
    padding: 0.9rem 1rem 0.5rem;
    overflow-y: auto;
    list-style: none;
  }
  .ws2 .hx-try__log li { margin: 0 0 0.25rem; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .ws2 .hx-try__log li.hint { color: var(--t-mute); font-style: italic; }
  .ws2 .hx-try__log .pr { margin-right: 0.5rem; color: #7ee787; }
  .ws2 .hx-try__log li.typing::after { content: "▍"; margin-left: 1px; color: var(--t-mute); }
  .ws2 .hx-try__keys button code { padding: 0; border: 0; background: none; color: inherit; }

  /* The four settings, step 1: the way from the tool through OpenRouter to the model. */
  .ws2 .hx-set { text-align: center; }
  .ws2 .hx-set__path {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) auto minmax(2rem, 1fr) auto;
    align-items: center;
    gap: 0.4rem;
    margin: 1.1rem 0 0.9rem;
  }
  .ws2 .hx-set__node {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--bg);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .ws2 .hx-set__node b { font-size: var(--step--1); }
  .ws2 .hx-set__node span { font-size: 0.72rem; color: var(--ink-muted); }
  .ws2 .hx-set__node.router { --c: #0f766e; --c-soft: #e3f4f1; }
  .ws2 .hx-set__wire { position: relative; height: 4px; border-radius: 2px; background: var(--rule-soft); transition: background-color 0.3s; }
  .ws2 .hx-set__wire .pkt {
    position: absolute;
    top: 50%;
    left: calc(50% - 0.4rem);
    width: 0.8rem;
    height: 0.8rem;
    margin-top: -0.4rem;
    border-radius: 50%;
    background: var(--bp-person);
    opacity: 0;
  }
  .ws2 .hx-set__wire .pkt .key {
    position: absolute;
    left: 50%;
    bottom: 0.95rem;
    width: 1.05rem;
    height: 1.05rem;
    margin-left: -0.52rem;
    color: #b45309;
    opacity: 0;
  }
  .ws2 .hx-set__ctx {
    display: grid;
    grid-template-columns: auto minmax(4rem, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    max-width: 30rem;
    margin: 0 auto 0.6rem;
    font-size: 0.75rem;
    color: var(--ink-muted);
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .ws2 .hx-set__ctx i { position: relative; height: 0.6rem; border: 1px solid var(--rule); border-radius: 999px; overflow: hidden; }
  .ws2 .hx-set__ctx i::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 35%; background: var(--bp-brain); }
  .ws2 .hx-set[data-mode="name"] .brain,
  .ws2 .hx-set[data-mode="key"] .router,
  .ws2 .hx-set[data-mode="url"] .router,
  .ws2 .hx-set[data-mode="ctx"] .tool { border-color: var(--c); box-shadow: 0 0 0 4px var(--c-soft); transform: translateY(-2px); }
  .ws2 .hx-set[data-mode="url"] .hx-set__wire,
  .ws2 .hx-set[data-mode="key"] .hx-set__wire { background: color-mix(in srgb, var(--bp-person) 40%, var(--rule-soft)); }
  .ws2 .hx-set[data-mode="url"] .pkt,
  .ws2 .hx-set[data-mode="key"] .pkt { opacity: 1; }
  .ws2 .hx-set[data-mode="key"] .pkt .key { opacity: 1; }
  .ws2 .hx-set[data-mode="ctx"] .hx-set__ctx { opacity: 1; color: var(--ink); }
  .ws2 .hx-set .hx-pick { max-width: 40rem; margin: 0.4rem auto 0; }
  @container (max-width: 34rem) {
    .ws2 .hx-set__path { grid-template-columns: 1fr; }
    .ws2 .hx-set__node { justify-self: center; min-width: 12rem; }
    .ws2 .hx-set__wire { justify-self: center; width: 4px; height: 1.8rem; }
    .ws2 .hx-set__wire .pkt { top: calc(50% - 0.4rem); left: 50%; margin: 0 0 0 -0.4rem; }
    .ws2 .hx-set__wire .pkt .key { left: 1rem; bottom: auto; top: -0.1rem; margin: 0; }
  }

  /* The prompt builder, step 5. */
  .ws2 .hx-build__keys { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; margin-bottom: 0.8rem; }
  .ws2 .hx-build__keys button {
    font: inherit;
    font-size: var(--step--1);
    padding: 0.3rem 0.85rem;
    border: 1px dashed var(--bp-person);
    border-radius: 999px;
    background: var(--bg);
    color: var(--bp-person);
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, transform 0.2s;
  }
  .ws2 .hx-build__keys button:hover { transform: translateY(-1px); }
  .ws2 .hx-build__keys button[aria-pressed="true"] { border-style: solid; background: var(--bp-person); color: #fff; }
  .ws2 .hx-build__prompt {
    position: relative;
    padding: 0.9rem 1rem 0.9rem 2.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.55;
    transition: border-color 0.4s, box-shadow 0.4s;
  }
  .ws2 .hx-build__prompt::before { content: ""; position: absolute; left: 1.1rem; top: 1.05rem; width: 1.05em; height: 1.05em; background-color: var(--bp-brain); -webkit-mask: var(--hx-sparkles) center / contain no-repeat; mask: var(--hx-sparkles) center / contain no-repeat; }
  .ws2 .hx-build__prompt p { margin: 0; }
  .ws2 .hx-build__prompt ol { margin: 0; padding: 0; list-style: none; }
  .ws2 .hx-build__prompt li { margin: 0.4rem 0 0; }
  .ws2 .hx-build__prompt li b {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0 0.4rem;
    border-radius: 0.3rem;
    background: var(--bp-person-soft);
    color: var(--bp-person);
    font-family: inherit;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    vertical-align: 0.12em;
  }
  .hx-js .ws2 .hx-build__prompt li:not(.on) { display: none; }
  .ws2 .hx-build__meter {
    display: grid;
    grid-template-columns: auto minmax(4rem, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .ws2 .hx-build__meter i { height: 0.55rem; border-radius: 999px; background: var(--rule-soft); overflow: hidden; }
  .ws2 .hx-build__meter u { display: block; height: 100%; width: calc(100% - var(--n, 0) * 25%); background: var(--bp-brain); transition: width 0.5s ease; }
  .ws2 .hx-build.is-done .hx-build__prompt { border-color: var(--hx-ok); box-shadow: 0 0 0 4px var(--hx-ok-soft); }
  .ws2 .hx-build.is-done .hx-build__meter em { color: var(--hx-ok); font-weight: 600; }

  /* Where Claude Code may read and write, step 9. */
  .ws2 .hx-box { text-align: center; }
  .ws2 .hx-tree {
    margin: 1rem 0 0.6rem;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    overflow: hidden;
    text-align: left;
  }
  .ws2 .hx-tree li {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto auto;
