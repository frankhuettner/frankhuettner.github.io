<script is:inline>
  // hw3's pictures and the sort quiz (Frank, 17 Nov 2026). Without this script every picture shows all its text at
  // once and the sort quiz stays a table, with the answers.
  (function () {
    document.documentElement.classList.add("hx-js");
    var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var each = function (sel, fn) { Array.prototype.forEach.call(document.querySelectorAll(sel), fn); };

    // A switch of two: the course's model or Claude (step 1), its own finish line or yours (step 4).
    each(".ws2 .hx-model, .ws2 .hx-loop, .ws2 .hx-set, .ws2 .hx-box", function (fig) {
      var buttons = fig.querySelectorAll(".hx-switch button"), picks = fig.querySelectorAll(".hx-pick");
      var key = function (b) { return b.dataset.pick || b.dataset.mode; };
      var pick = function (v) {
        Array.prototype.forEach.call(buttons, function (b) { b.setAttribute("aria-pressed", String(key(b) === v)); });
        Array.prototype.forEach.call(picks, function (p) { p.classList.toggle("on", p.dataset.for === v); });
        fig.dataset.mode = v;
      };
      Array.prototype.forEach.call(buttons, function (b) { b.addEventListener("click", function () { pick(key(b)); }); });
      pick(key(buttons[0]));
    });

    // The replay of our test run (step 6): one line after the other; Esc, the button or the key, stops it.
    each(".ws2 .hx-term", function (t) {
      var log = t.querySelector(".hx-term__log");
      if (!log) return;   // the first lines of Claude Code (step 1): a still picture
      var lines = Array.prototype.slice.call(log.children);
      var bar = t.querySelector(".hx-term__bar"), esc = t.querySelector(".hx-esc"), play = t.querySelector(".hx-play");
      var note = t.querySelector(".hx-term__note"), keys = t.querySelector(".hx-term__keys");
      var more = document.createElement("button"); more.type = "button"; more.className = "hx-more";
      more.textContent = "Show what came next"; more.hidden = true; keys.appendChild(more);
      var shown = 0, timer = null, running = false;
      var show = function (n) {
        shown = n;
        lines.forEach(function (l, k) { l.classList.toggle("on", k < n); });
        log.scrollTop = log.scrollHeight;
        bar.style.setProperty("--p", String(n / lines.length));
      };
      var reps = function () { return lines.filter(function (l) { return l.classList.contains("rep") && l.classList.contains("on"); }).length; };
      var end = function (pressed) {
        clearTimeout(timer); running = false; esc.disabled = true; play.textContent = "Play again";
        t.classList.add(pressed ? "is-stopped" : "is-done");
        more.hidden = !pressed || shown >= lines.length;
        var n = reps();
        note.textContent = pressed
          ? (n === 0 ? "You pressed Esc early. That is fine: a question costs you only a minute. "
             : n === 1 ? "You pressed Esc after the first marked line. Good: after it, Claude Code said the same thing three more times, each time a little differently. "
             : "You pressed Esc after Claude Code had said the same thing " + n + " times (marked). Good that you stopped it. ")
            + "Next, you should ask Claude Code what it is trying, and why the last try did not work. In our test, nobody pressed Esc: as a consequence, Claude Code went on for 23 minutes."
          : "Nobody pressed Esc: Claude Code went on for 23 minutes. It said the same thing four times (marked), switched to Chinese, and wrote its last report in Chinese too. Press Play again, and stop it where you would.";
      };
      var tick = function () {
        show(shown + 1);
        if (shown >= lines.length) return end(false);
        var last = lines[shown - 1].classList;
        timer = setTimeout(tick, last.contains("think") ? 1200 : last.contains("you") ? 1000 : 2000);
      };
      var start = function () {
        clearTimeout(timer); t.classList.remove("is-done", "is-stopped"); note.textContent = ""; more.hidden = true;
        show(0); running = true; esc.disabled = false; play.textContent = "Start again"; tick();
      };
      esc.addEventListener("click", function () { if (running) end(true); });
      play.addEventListener("click", start);
      more.addEventListener("click", function () { show(lines.length); more.hidden = true; t.classList.remove("is-stopped"); t.classList.add("is-done"); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && running) { e.preventDefault(); end(true); } });
      t.addEventListener("hx-in", function () { if (!calm && !running && shown === 0) start(); });
    });

    // What the model reads at every step (step 7): a third correction adds to it, /clear empties it.
    each(".ws2 .hx-ctx", function (fig) {
      var list = fig.querySelector(".hx-ctx__blocks"), say = fig.querySelector(".hx-ctx__say");
      var original = list.innerHTML, tries = 2, cleared = false;
      var add = function (cls, text) {
        var li = document.createElement("li"); li.className = cls + " new"; li.textContent = text; list.appendChild(li);
      };
      fig.querySelector('[data-act="more"]').addEventListener("click", function () {
        if (cleared) { list.innerHTML = original; tries = 2; cleared = false; }
        tries += 1; add("bad", "Try " + tries + " ✗"); add("you", "Correction");
        say.textContent = "Now the model reads " + tries + " failed tries at every step. And on your OpenRouter key, every step sends all of it again.";
      });
      fig.querySelector('[data-act="clear"]').addEventListener("click", function () {
        if (cleared) return;
        var old = Array.prototype.slice.call(list.querySelectorAll("li:not(.start)"));
        old.forEach(function (li, k) { li.style.setProperty("--k", String(k)); li.classList.add("out"); });
        setTimeout(function () {
          old.forEach(function (li) { li.remove(); });
          add("fresh", "One new prompt, with what you learned");
        }, calm ? 0 : 420 + old.length * 40);
        cleared = true;
        say.textContent = "A fresh start: the model gets the start files again, and the failed tries are gone. Press the other button to start over.";
      });
    });

    // The habits on one page as cards (the table stays, hidden, for the reader without styles).
    each(".ws2 .habits table", function (table) {
      var ol = document.createElement("ol"); ol.className = "habit-cards";
      Array.prototype.forEach.call(table.querySelectorAll("tbody tr"), function (tr, i) {
        var li = document.createElement("li"); li.style.setProperty("--i", String(i));
        var b = document.createElement("b"); b.innerHTML = tr.children[0].innerHTML;
        var gain = document.createElement("span"); gain.className = "gain"; gain.innerHTML = tr.children[1].innerHTML;
        var src = document.createElement("span"); src.className = "habit-src"; src.innerHTML = "Source: " + tr.children[2].innerHTML;
        li.append(b, gain, src); ol.appendChild(li);
      });
      table.before(ol); table.hidden = true;
    });

    // The sort quiz: the cards wait above the boxes, shuffled; drag each into its box, or click it, then the box.
    each(".ws2 .quiz.sort", function (box) {
      var table = box.querySelector("table");
      if (!table) return;
      var rows = Array.prototype.map.call(table.querySelectorAll("tbody tr"), function (tr) {
        return { html: tr.children[0].innerHTML, bin: tr.children[1].textContent.trim() };
      });
      var names = [];
      rows.forEach(function (r) { if (names.indexOf(r.bin) < 0) names.push(r.bin); });
      var pool = document.createElement("div"); pool.className = "sq-pool";
      var bins = document.createElement("div"); bins.className = "sq-bins";
      var bar = document.createElement("div"); bar.className = "sq-bar";
      var check = document.createElement("button"); check.type = "button"; check.textContent = "Check my answers";
      var solve = document.createElement("button"); solve.type = "button"; solve.textContent = "Show the solution";
      var again = document.createElement("button"); again.type = "button"; again.textContent = "Try again";
      var status = document.createElement("span"); status.setAttribute("aria-live", "polite");
      bar.append(check, solve, again, status);
      var picked = null;
      var zones = names.map(function (name) {
        var z = document.createElement("div"); z.className = "sq-bin"; z.dataset.bin = name;
        var head = document.createElement("b"); head.textContent = name; z.appendChild(head);
        z.addEventListener("click", function () { if (picked) put(picked, z); });
        z.addEventListener("dragover", function (e) { e.preventDefault(); z.classList.add("over"); });
        z.addEventListener("dragleave", function () { z.classList.remove("over"); });
        z.addEventListener("drop", function (e) {
          e.preventDefault(); z.classList.remove("over");
          var c = box.querySelector('.sq-chip[data-i="' + e.dataTransfer.getData("text/plain") + '"]');
          if (c) put(c, z);
        });
        bins.appendChild(z); return z;
      });
      var put = function (c, where) {
        fly(c, where); c.classList.remove("picked", "right", "wrong"); picked = null; status.textContent = "";
      };
      var chip = function (i) {
        var c = document.createElement("span"); c.className = "sq-chip"; c.innerHTML = rows[i].html; c.dataset.i = String(i);
        c.draggable = true; c.tabIndex = 0;
        c.addEventListener("dragstart", function (e) { e.dataTransfer.setData("text/plain", String(i)); });
        c.addEventListener("click", function (e) {
          e.stopPropagation();
          if (c.parentNode !== pool) { put(c, pool); return; }
          picked = picked === c ? null : c;
          Array.prototype.forEach.call(box.querySelectorAll(".sq-chip"), function (o) { o.classList.toggle("picked", o === picked); });
        });
        c.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); c.click(); } });
        return c;
      };
      var start = function () {
        pool.innerHTML = ""; zones.forEach(function (z) { Array.prototype.forEach.call(z.querySelectorAll(".sq-chip"), function (c) { c.remove(); }); });
        var order = rows.map(function (_, i) { return i; });
        for (var k = order.length - 1; k > 0; k--) { var j = Math.floor(Math.random() * (k + 1)); var t = order[k]; order[k] = order[j]; order[j] = t; }
        order.forEach(function (i) { pool.appendChild(chip(i)); });
        pool.hidden = false; check.hidden = false; solve.hidden = false; again.hidden = true;
        status.textContent = "Drag each card into its box. Or click a card, then its box.";
      };
      check.addEventListener("click", function () {
        var right = 0, placed = 0, wrong = [];
        zones.forEach(function (z) {
          Array.prototype.forEach.call(z.querySelectorAll(".sq-chip"), function (c) {
            placed++; var ok = rows[+c.dataset.i].bin === z.dataset.bin;
            c.classList.toggle("right", ok); c.classList.toggle("wrong", !ok); if (ok) right++; else wrong.push(c);
          });
        });
        if (right === rows.length) {
          status.textContent = "All " + rows.length + " right. Well done!";
          pool.hidden = true; check.hidden = true; solve.hidden = true; again.hidden = false;
          burst(bins); solved(box);
          return;
        }
        status.textContent = right + " of " + rows.length + " right." +
          (wrong.length ? " The wrong ones go back to the top: try them again." : "") +
          (placed < rows.length ? " " + (rows.length - placed) + " still to sort." : "");
        setTimeout(function () {
          wrong.forEach(function (c) { if (c.classList.contains("wrong")) { c.classList.remove("wrong"); fly(c, pool); } });
        }, calm ? 700 : 1100);
      });
      solve.addEventListener("click", function () {
        Array.prototype.forEach.call(box.querySelectorAll(".sq-chip"), function (c) {
          var z = zones[names.indexOf(rows[+c.dataset.i].bin)]; fly(c, z); c.classList.remove("picked", "wrong"); c.classList.add("right");
        });
        check.hidden = true; solve.hidden = true; again.hidden = false; status.textContent = "";
        setTimeout(function () { pool.hidden = true; }, calm ? 0 : 360);
      });
      again.addEventListener("click", start);
      table.before(pool); table.before(bins); table.before(bar); table.hidden = true;
      start();
    });

    // ---- More to click, more motion (Frank, 18 Nov 2026). ----

    // A burst of colour where something was solved; none for readers who asked for less motion.
    function burst(el) {
      if (calm || !el || !el.getBoundingClientRect) return;
      var r = el.getBoundingClientRect(), host = document.createElement("span");
      host.className = "hx-burst"; host.setAttribute("aria-hidden", "true");
      host.style.left = (r.left + r.width / 2 + window.scrollX) + "px";
      host.style.top = (r.top + r.height / 2 + window.scrollY) + "px";
      for (var k = 0; k < 16; k++) {
        var p = document.createElement("i"), a = k / 16 * 2 * Math.PI + Math.random() * 0.4, d = 38 + Math.random() * 48;
        p.style.setProperty("--x", Math.round(Math.cos(a) * d) + "px");
        p.style.setProperty("--y", Math.round(Math.sin(a) * d) + "px");
        p.style.setProperty("--c", ["#ff6c0f", "#2563eb", "#15803d", "#f5b301"][k % 4]);
        host.appendChild(p);
      }
      document.body.appendChild(host);
      setTimeout(function () { host.remove(); }, 1000);
    }

    // Move an element to its new place, and let it fly there from where it was.
    function fly(el, where) {
      var a = el.isConnected ? el.getBoundingClientRect() : null;
      where.appendChild(el);
      if (calm || !a || !el.animate) return;
      var b = el.getBoundingClientRect();
      el.animate([{ transform: "translate(" + (a.left - b.left) + "px, " + (a.top - b.top) + "px)" }, { transform: "none" }],
        { duration: 340, easing: "cubic-bezier(0.2, 0.7, 0.3, 1)" });
    }

    // The quizzes of a page: a row of dots in each, one per quiz, filled when it is solved (kept in this browser).
    var quizzes = Array.prototype.slice.call(document.querySelectorAll(".ws2 .quiz"));
    var qkey = "hx-quiz:" + location.pathname, qdone = {};
    try { qdone = JSON.parse(localStorage.getItem(qkey) || "{}") || {}; } catch (e) { qdone = {}; }
    function paintDots() {
      quizzes.forEach(function (q) {
        Array.prototype.forEach.call(q.querySelectorAll(".qz-dots i"), function (dot, k) { dot.classList.toggle("on", !!qdone[k]); });
        q.classList.toggle("is-solved", !!qdone[q.dataset.qi]);
      });
    }
    function solved(q) {
      if (!q || q.dataset.qi === undefined) return;
      var first = !qdone[q.dataset.qi];
      qdone[q.dataset.qi] = 1;
      try { localStorage.setItem(qkey, JSON.stringify(qdone)); } catch (e) {}
      paintDots();
      if (first) burst(q.querySelector(".qz-dots i.me"));
    }
    quizzes.forEach(function (q, i) {
      q.dataset.qi = String(i);
      if (quizzes.length < 2) return;
      var row = document.createElement("div"); row.className = "qz-dots";
      var lab = document.createElement("span"); lab.textContent = "Quiz " + (i + 1) + " of " + quizzes.length + " on this page";
      row.appendChild(lab);
      quizzes.forEach(function (_, k) {
        var dot = document.createElement("i"); dot.setAttribute("aria-hidden", "true"); if (k === i) dot.className = "me"; row.appendChild(dot);
      });
      q.prepend(row);
    });
    paintDots();

    // A choice quiz: right gives a burst; after a wrong choice, the right answer lights up.
    document.addEventListener("click", function (e) {
      var b = e.target.closest ? e.target.closest(".ws2 .quiz-options button") : null;
      if (!b) return;
      var opts = b.parentNode, q = b.closest(".quiz");
      Array.prototype.forEach.call(opts.children, function (o) { o.classList.remove("hx-hint"); });
      if (b.hasAttribute("data-right")) { burst(b); solved(q); return; }
      b.style.animation = "none"; void b.offsetWidth; b.style.animation = "";
      var r = opts.querySelector("[data-right]");
      if (r) setTimeout(function () { if (!r.classList.contains("right")) r.classList.add("hx-hint"); }, 500);
    });

    // A match quiz: a burst when all are right (its own script writes "All … right").
    each(".ws2 .quiz.match", function (q) {
      var bar = q.querySelector(".ma-bar");
      if (!bar || !window.MutationObserver) return;
      var was = false;
      new MutationObserver(function () {
        var now = /All \d+ right/.test(bar.textContent);
        if (now && !was) { burst(bar); solved(q); }
        was = now;
      }).observe(bar, { subtree: true, childList: true, characterData: true });
    });

    // The terminal for practice (before step 1): a click types the command, then Ubuntu's answer appears. As in a
    // real terminal, a new line with the folder waits after each command. cd answers nothing, so a hint says what
    // changed (Frank, 18 Nov 2026: "after cd and after cd ~/kingo-pod, nothing is happening").
    each(".ws2 .hx-try", function (fig) {
      var log = fig.querySelector(".hx-try__log"), out;
      try { out = JSON.parse(fig.dataset.out); } catch (e) { return; }
      var cwd = "~", busy = false, wait;
      var line = function (cls, text) {
        var li = document.createElement("li"); if (cls) li.className = cls; if (text) li.textContent = text;
        log.appendChild(li); log.scrollTop = log.scrollHeight; return li;
      };
      var prompt = function () {
        var pr = document.createElement("span");
        pr.className = "pr"; pr.textContent = "anna@laptop:" + cwd + "$";
        wait = line("you typing"); wait.appendChild(pr);
      };
      var named = function (f) { return f === "~" ? "~, your home folder" : f; };
      log.innerHTML = "";
      line("hint", "Click a command below.");
      prompt();
      var run = function (cmd) {
        if (busy) return;
        busy = true;
        Array.prototype.forEach.call(log.querySelectorAll(".hint"), function (h) { h.remove(); });
        var li = wait, typed = document.createTextNode(""), k = 0;
        li.appendChild(typed);
        var step = function () {
          if (!calm && k < cmd.length) { typed.data += cmd.charAt(k++); setTimeout(step, 45); return; }
          typed.data = cmd; li.classList.remove("typing");
          if (cmd === "clear") log.innerHTML = "";
          else if (cmd === "cd" || cmd === "cd ~/kingo-pod") {
            var to = cmd === "cd" ? "~" : "~/kingo-pod";
            line("hint", "cd shows nothing: it only changes the folder. " + (to === cwd
              ? "The folder stays " + named(to) + ": you were in it already."
              : "Before the dollar sign, you now see " + named(to) + "."));
            cwd = to;
          }
          else if (out[cwd] && out[cwd][cmd]) line("out", out[cwd][cmd]);
          prompt();
          busy = false;
        };
        setTimeout(step, calm ? 0 : 120);
      };
      Array.prototype.forEach.call(fig.querySelectorAll(".hx-try__keys button"), function (b) {
        b.addEventListener("click", function () { run(b.dataset.cmd); });
      });
    });

    // The prompt builder (step 5): each button adds one piece; the bar shows how much is left to guess.
    each(".ws2 .hx-build", function (fig) {
      var buttons = Array.prototype.slice.call(fig.querySelectorAll(".hx-build__keys button"));
      var say = fig.querySelector(".hx-build__meter em"), words = ["a lot", "still a lot", "less", "little", "almost nothing"];
      var paint = function (fresh) {
        var n = buttons.filter(function (b) { return b.getAttribute("aria-pressed") === "true"; }).length;
        fig.style.setProperty("--n", String(n));
        say.textContent = words[Math.min(n, words.length - 1)];
        var all = n === buttons.length;
        if (all && fresh && !fig.classList.contains("is-done")) burst(fig.querySelector(".hx-build__prompt"));
        fig.classList.toggle("is-done", all);
      };
      buttons.forEach(function (b) {
        b.addEventListener("click", function () {
          var on = b.getAttribute("aria-pressed") !== "true";
          b.setAttribute("aria-pressed", String(on));
          b.textContent = (on ? "✓ " : "+ ") + b.textContent.slice(2);
          var li = fig.querySelector('.hx-build__prompt li[data-k="' + b.dataset.k + '"]');
          if (li) li.classList.toggle("on", on);
          paint(true);
        });
      });
      paint(false);
    });

    // The website's five steps (step 10): tick each one off; all five give a burst (kept in this browser).
    each(".ws2 .checklist", function (box) {
      var list = box.querySelector("ol");
      if (!list) return;
      var items = Array.prototype.slice.call(list.children), key = "hx-check:" + location.pathname, done = {};
      try { done = JSON.parse(localStorage.getItem(key) || "{}") || {}; } catch (e) { done = {}; }
      var bar = document.createElement("div"); bar.className = "ck-bar";
      var text = document.createElement("span"); text.className = "ck-text"; text.setAttribute("aria-live", "polite");
      var track = document.createElement("span"); track.className = "ck-track";
      var fill = document.createElement("i"); track.appendChild(fill); bar.append(text, track); box.prepend(bar);
      var paint = function (fresh) {
        var n = items.filter(function (_, k) { return done[k]; }).length, all = n === items.length;
        text.textContent = all ? "All " + n + " done: you planned and built a website with Claude Code."
          : n + " of " + items.length + " done";
        fill.style.width = (100 * n / items.length) + "%";
        if (all && fresh && !box.classList.contains("is-done")) burst(bar);
        box.classList.toggle("is-done", all);
      };
      items.forEach(function (li, k) {
        var b = document.createElement("button"); b.type = "button"; b.className = "ck";
        b.setAttribute("aria-label", "Item " + (k + 1) + " done"); b.setAttribute("aria-pressed", String(!!done[k]));
        b.addEventListener("click", function () {
          done[k] = done[k] ? 0 : 1; b.setAttribute("aria-pressed", String(!!done[k]));
          try { localStorage.setItem(key, JSON.stringify(done)); } catch (e) {}
          paint(true);
        });
        li.prepend(b);
      });
      paint(false);
    });

    // "Your turn" and "Next time": the two kinds of task, as labels.
    each(".ws2 p > strong:first-child", function (s) {
      if (s.previousSibling && s.previousSibling.nodeType === 3 && s.previousSibling.data.trim()) return;
      var t = s.textContent.trim();
      if (/^Your turn\b/.test(t)) s.parentNode.classList.add("hx-turn");
      else if (/^Next time\b/.test(t)) s.parentNode.classList.add("hx-next");
    });

    // Links to other sites: Base.astro, for the whole site (Frank, 18 Nov 2026: "ganze seite").

    // Each picture starts to move when it scrolls into view.
    var targets = document.querySelectorAll(".ws2 .hx, .ws2 .habit-cards, .ws2 p.hx-turn");
    var seen = function (el) { el.classList.add("is-in"); el.dispatchEvent(new CustomEvent("hx-in")); };
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { seen(e.target); io.unobserve(e.target); } });
      }, { threshold: 0.35 });
      Array.prototype.forEach.call(targets, function (el) { io.observe(el); });
    } else {
      Array.prototype.forEach.call(targets, seen);
    }
  })();
</script>
