---
import type { Paper } from "../lib/bib";

interface Props {
  paper: Paper;
  /** Show the year in the left rail (publications page) or inline (home). */
  showYear?: boolean;
}

const { paper, showYear = true } = Astro.props;

// "forthcoming" / "accepted" arrive as a non-numeric year; surface them only
// when the entry does not already carry full volume-and-page details.
const status = /^\d+$/.test(paper.yearLabel) ? null : paper.yearLabel;

const number = paper.number && !/^(none|n\/a)$/i.test(paper.number) ? paper.number : null;
const volume = paper.volume ? `${paper.volume}${number ? `(${number})` : ""}` : null;
const pages = paper.pages && /\d/.test(paper.pages) ? paper.pages.replace(/\s*-{1,3}\s*/, "\u2013") : null;

const disclosures = [
  paper.abstract ? { key: "abstract", label: "Abstract" } : null,
  paper.bibtex ? { key: "bibtex", label: "BibTeX" } : null,
].filter((d) => d !== null);

const citation = [[paper.venue, volume].filter(Boolean).join(" "), pages, volume && pages ? null : status]
  .filter(Boolean)
  .join(", ");

---

<article class:list={["paper", !showYear && "paper--flush"]}>
  {showYear && <div class="paper__year label">{paper.yearLabel}</div>}

  <div class:list={["paper__main", paper.preview && "paper__main--cover"]}>
    {paper.preview && (
      <img
        class="paper__cover"
        src={`/assets/img/publication_preview/${paper.preview}`}
        alt={paper.venue ? `${paper.venue} cover` : "Publication preview"}
        loading="lazy"
        decoding="async"
      />
    )}

    <div class="paper__body">
    <h3 class="paper__title">{paper.title}</h3>

    <p class="paper__authors">
      {
        paper.authors.map((a, i) => (
          <>
            {i > 0 && ", "}
            {a.url ? (
              <a class="coauthor" href={a.url}>
                {a.name}
              </a>
            ) : (
              <span class={a.isSelf ? "self" : undefined}>{a.name}</span>
            )}
          </>
        ))
      }
    </p>

    {citation && <p class="paper__venue">{citation}</p>}

    {
      (paper.links.length > 0 || disclosures.length > 0) && (
        <p class="paper__links">
          {paper.links.map((l) => (
            <a class="btn" href={l.href}>
              {l.label}
            </a>
          ))}
          {disclosures.map((d) => (
            <button type="button" class="btn" data-disclosure={d.key} aria-expanded="false">
              {d.label}
            </button>
          ))}
        </p>
      )
    }

    {paper.abstract && (
      <div class="paper__panel paper__abstract" data-panel="abstract" hidden>
        {paper.abstract}
      </div>
    )}

    {paper.bibtex && (
      <pre class="paper__panel paper__bibtex" data-panel="bibtex" hidden><code>{paper.bibtex}</code></pre>
    )}
    </div>
  </div>
</article>

<style>
  .paper {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr);
    gap: 0 var(--rail-gap);
    padding-block: 1.4rem;
  }

  .paper + .paper {
    border-top: 1px solid var(--rule-soft);
  }

  .paper--flush {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .paper__year {
    padding-top: 0.42rem;
    font-variant-numeric: tabular-nums;
  }

  .paper__main--cover {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .paper__cover {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    background: var(--bg-soft);
  }

  .paper__title {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.35;
  }

  .paper__authors,
  .paper__venue {
    margin: 0.28rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Accent-coloured, as on the al-folio site: against the muted author line
     a hairline underline alone was indistinguishable from plain text. */
  .coauthor {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
    text-underline-offset: 0.18em;
  }

  .coauthor:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .paper__authors .self {
    color: var(--ink);
    font-weight: 600;
  }

  .paper__venue {
    font-style: italic;
  }

  .paper__links {
    margin: 0.65rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .paper__panel {
    margin-top: 0.85rem;
  }

  .paper__abstract {
    padding: 0.85rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .paper__bibtex {
    padding: 0.85rem 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--ink-muted);
    white-space: pre;
  }

  @media (max-width: 46rem) {
    .paper {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .paper__year {
      padding-top: 0;
      margin-bottom: 0.35rem;
    }

    .paper__main--cover {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.85rem;
    }
  }
</style>
